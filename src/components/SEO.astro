---
import { langCodes, getLocalizedPath, getPathWithoutLang } from '../i18n/index';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
  lang?: string;
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  canonicalURL,
  lang = 'en',
} = Astro.props;

const siteName = 'BreadRatio';
const fullTitle = title.includes('BreadRatio') ? title : `${title} - BreadRatio`;
const imageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : null;

const locales: Record<string, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  es: 'es_ES',
  ar: 'ar_SA',
  pt: 'pt_BR',
  ja: 'ja_JP',
  de: 'de_DE',
};

const currentCanonical = canonicalURL || Astro.url.href;
const cleanPath = getPathWithoutLang(Astro.url.pathname);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={currentCanonical} />

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={currentCanonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locales[lang] || 'en_US'} />
{imageUrl && (
  <>
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}

<!-- hreflang alternate links -->
{Astro.site ? langCodes.map(code => {
  const localizedPath = getLocalizedPath(cleanPath, code);
  try {
    const url = new URL(localizedPath, Astro.site).href;
    return <link rel="alternate" hreflang={code} href={url} />;
  } catch {
    return null;
  }
}) : null}
{Astro.site ? (
  (() => {
    try {
      return <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(cleanPath, 'en'), Astro.site).href} />;
    } catch { return null; }
  })()
) : null}

<!-- Twitter -->
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<!-- No cookie banners needed - we don't track anything -->
<meta name="referrer" content="strict-origin-when-cross-origin" />
