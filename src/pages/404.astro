---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { t, getLocalizedPath, getLangFromUrl } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout
  title={t(lang, 'notFound.pageTitle')}
  description={t(lang, 'notFound.pageDesc')}
  lang={lang}
>
  <section class="hero">
    <div class="container">
      <h1>{t(lang, 'notFound.title')}</h1>
      <p>{t(lang, 'notFound.subtitle')}</p>
      <div style="display:flex;gap:var(--space-md);justify-content:center;flex-wrap:wrap;margin-top:var(--space-xl);">
        <a href={getLocalizedPath('/', lang)} class="btn btn-primary">{t(lang, 'notFound.goHome')}</a>
        <a href={getLocalizedPath('/hydration-calculator/', lang)} class="btn btn-secondary">{t(lang, 'notFound.tryHydration')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
