---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { t, getLocalizedPath, langCodes, defaultLang } from '../../i18n/index';

export function getStaticPaths() {
  return langCodes
    .filter(code => code !== defaultLang)
    .map(code => ({ params: { lang: code } }));
}

const { lang } = Astro.params;
import { buildFAQPageSchema, buildSoftwareAppSchema, buildBreadcrumbSchema } from '../../utils/seo.js';
const faqSchema = buildFAQPageSchema([
  { question: t(lang, 'starter.faq1Q'), answer: t(lang, 'starter.faq1A') },
  { question: t(lang, 'starter.faq2Q'), answer: t(lang, 'starter.faq2A') },
  { question: t(lang, 'starter.faq3Q'), answer: t(lang, 'starter.faq3A') },
  { question: t(lang, 'starter.faq4Q'), answer: t(lang, 'starter.faq4A') },
  { question: t(lang, 'starter.faq5Q'), answer: t(lang, 'starter.faq5A') },
  { question: t(lang, 'starter.faq6Q'), answer: t(lang, 'starter.faq6A') },
  { question: t(lang, 'starter.faq7Q'), answer: t(lang, 'starter.faq7A') },
]);
const appSchema = buildSoftwareAppSchema({
  name: t(lang, 'starter.pageTitle'),
  url: `https://breadratio.com/${lang}/sourdough-starter-calculator/`,
  description: t(lang, 'starter.pageDesc'),
});
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: t(lang, 'nav.home'), url: 'https://breadratio.com' + getLocalizedPath('/', lang) },
  { name: t(lang, 'starter.title'), url: 'https://breadratio.com' + getLocalizedPath('/sourdough-starter-calculator/', lang) },
]);
const starterTexts = {
  flourToAdd: t(lang, 'starter.flourToAdd'),
  waterToAdd: t(lang, 'starter.waterToAdd'),
  totalAfterFeeding: t(lang, 'starter.totalAfterFeeding'),
  starterHydration: t(lang, 'starter.starterHydration'),
  flourNeeded: t(lang, 'starter.flourNeeded'),
  waterNeeded: t(lang, 'starter.waterNeeded'),
  useExistingStarter: t(lang, 'starter.useExistingStarter'),
  discardAmount: t(lang, 'starter.discardAmount'),
  noneNeeded: t(lang, 'starter.noneNeeded'),
  newStarterTotal: t(lang, 'starter.newStarterTotal'),
  achievableTotal: t(lang, 'starter.achievableTotal'),
  requiredStarter: t(lang, 'starter.requiredStarter'),
  targetShortfall: t(lang, 'starter.targetShortfall'),
  targetNotReachable: t(lang, 'starter.targetNotReachable'),
  insufficientStarterNote: t(lang, 'starter.insufficientStarterNote'),
  enterStarter: t(lang, 'starter.enterStarter'),
  enterDesired: t(lang, 'starter.enterDesired'),
  copyResult: t(lang, 'calc.copyResult'),
  copied: t(lang, 'calc.copied'),
};
---

<BaseLayout title={t(lang, 'starter.pageTitle')} description={t(lang, 'starter.pageDesc')} currentPath={`/${lang}/sourdough-starter-calculator/`} lang={lang}>
  <section class="container page-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', lang)}>{t(lang, 'nav.home')}</a>
      <span class="sep">/</span>
      <span>{t(lang, 'home.tools.starter.title')}</span>
    </nav>

    <div class="page-header">
      <h1>{t(lang, 'starter.title')}</h1>
      <p>{t(lang, 'starter.subtitle')}</p>
    </div>

    <div style="display:flex;gap:var(--space-sm);margin-bottom:var(--space-lg);flex-wrap:wrap;">
      <button class="btn btn-secondary btn-sm mode-tab active" data-mode="feeding" id="tabFeeding">{t(lang, 'starter.tabFeeding')}</button>
      <button class="btn btn-ghost btn-sm mode-tab" data-mode="target" id="tabTarget">{t(lang, 'starter.tabTarget')}</button>
    </div>

    <div class="calc-card">
      <div id="modeFeeding">
        <div class="input-group">
          <label for="feedStarter">{t(lang, 'starter.currentStarter')} <span class="unit">({t(lang, 'calc.grams')})</span></label>
          <div class="input-field">
            <input type="number" id="feedStarter" placeholder="100" inputmode="decimal" min="0" step="any" value="100" />
            <span class="input-suffix">{t(lang, 'calc.grams')}</span>
          </div>
        </div>

        <div style="margin-bottom:var(--space-lg);">
          <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--color-brown-light);margin-bottom:var(--space-xs);">{t(lang, 'starter.feedingRatio')}</label>
          <div class="presets">
            <button class="preset-btn ratio-btn active" data-ratio="1:1:1">1:1:1</button>
            <button class="preset-btn ratio-btn" data-ratio="1:2:2">1:2:2</button>
            <button class="preset-btn ratio-btn" data-ratio="1:3:3">1:3:3</button>
            <button class="preset-btn ratio-btn" data-ratio="1:4:4">1:4:4</button>
            <button class="preset-btn ratio-btn" data-ratio="1:5:5">1:5:5</button>
          </div>
        </div>

        <div class="result-display" aria-live="polite" aria-atomic="true">
          <h3 style="margin-bottom:var(--space-md);">{t(lang, 'starter.feedingResults')}</h3>
          <div id="feedResults"></div>
          <button class="btn-copy" id="copyFeed" style="margin-top:12px;" data-texts={JSON.stringify(starterTexts)}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            {t(lang, 'calc.copyResult')}
          </button>
        </div>
      </div>

      <div id="modeTarget" style="display:none;">
        <div class="input-row">
          <div class="input-group">
            <label for="targetAmount">{t(lang, 'starter.desiredFinalAmount')} <span class="unit">({t(lang, 'calc.grams')})</span></label>
            <div class="input-field">
              <input type="number" id="targetAmount" placeholder="400" inputmode="decimal" min="0" step="any" value="400" />
              <span class="input-suffix">{t(lang, 'calc.grams')}</span>
            </div>
          </div>
          <div class="input-group">
            <label for="existingStarter">{t(lang, 'starter.existingStarter')} <span class="unit">({t(lang, 'calc.grams')})</span></label>
            <div class="input-field">
              <input type="number" id="existingStarter" placeholder="200" inputmode="decimal" min="0" step="any" value="200" />
              <span class="input-suffix">{t(lang, 'calc.grams')}</span>
            </div>
          </div>
        </div>

        <div style="margin-bottom:var(--space-lg);">
          <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--color-brown-light);margin-bottom:var(--space-xs);">{t(lang, 'starter.feedingRatio')}</label>
          <div class="presets">
            <button class="preset-btn ratio-btn-target active" data-ratio="1:1:1">1:1:1</button>
            <button class="preset-btn ratio-btn-target" data-ratio="1:2:2">1:2:2</button>
            <button class="preset-btn ratio-btn-target" data-ratio="1:3:3">1:3:3</button>
            <button class="preset-btn ratio-btn-target" data-ratio="1:4:4">1:4:4</button>
            <button class="preset-btn ratio-btn-target" data-ratio="1:5:5">1:5:5</button>
          </div>
        </div>

        <div class="result-display" aria-live="polite" aria-atomic="true">
          <h3 style="margin-bottom:var(--space-md);">{t(lang, 'starter.targetResults')}</h3>
          <div id="targetResults"></div>
          <button class="btn-copy" id="copyTarget" style="margin-top:12px;" data-texts={JSON.stringify(starterTexts)}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            {t(lang, 'calc.copyResult')}
          </button>
        </div>
      </div>
    </div>

    <div class="info-cards" id="infoCards">
      <div class="info-card"><div class="range">{t(lang, 'starter.infoCards.1:1:1.title')}</div><div class="desc">{t(lang, 'starter.infoCards.1:1:1.desc')}</div></div>
      <div class="info-card"><div class="range">{t(lang, 'starter.infoCards.1:2:2.title')}</div><div class="desc">{t(lang, 'starter.infoCards.1:2:2.desc')}</div></div>
      <div class="info-card"><div class="range">{t(lang, 'starter.infoCards.1:3:3.title')}</div><div class="desc">{t(lang, 'starter.infoCards.1:3:3.desc')}</div></div>
      <div class="info-card"><div class="range">{t(lang, 'starter.infoCards.1:4:4.title')}</div><div class="desc">{t(lang, 'starter.infoCards.1:4:4.desc')}</div></div>
    </div>

    <div class="faq-section">
      <script type="application/ld+json" set:html={appSchema}></script>
      <script type="application/ld+json" set:html={faqSchema}></script>
      <script type="application/ld+json" set:html={breadcrumbSchema}></script>
      <h2>{t(lang, 'starter.faqTitle')}</h2>
      <details class="faq-item" open>
        <summary>{t(lang, 'starter.faq1Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq1A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq2Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq2A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq3Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq3A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq4Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq4A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq5Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq5A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq6Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq6A')}</p></div>
      </details>
      <details class="faq-item">
        <summary>{t(lang, 'starter.faq7Q')}</summary>
        <div class="faq-answer"><p>{t(lang, 'starter.faq7A')}</p></div>
      </details>
    </div>

    <div class="related-tools">
      <h3>{t(lang, 'calc.relatedTools')}</h3>
      <ul>
        <li><a href={getLocalizedPath('/hydration-calculator/', lang)}>{t(lang, 'home.tools.hydration.title')}</a></li>
        <li><a href={getLocalizedPath('/recipe-scaler/', lang)}>{t(lang, 'home.tools.scaler.title')}</a></li>
        <li><a href={getLocalizedPath('/bakers-percentage/', lang)}>{t(lang, 'home.tools.bakers.title')}</a></li>
        <li><a href={getLocalizedPath('/yeast-converter/', lang)}>{t(lang, 'home.tools.yeast.title')}</a></li>
        <li><a href={getLocalizedPath('/pizza-dough-calculator/', lang)}>{t(lang, 'home.tools.pizza.title')}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import { buildCopyText, getCopyButtonMarkup, escapeHtml } from '../../utils/calculator-ui.js';
  import { calculateSourdoughTargetPlan } from '../../utils/calculator-helpers.js';

  function init() {
    function sanitizeNum(val: string): number {
      const n = parseFloat(val);
      if (isNaN(n) || !isFinite(n)) return 0;
      return n;
    }

    function parseRatio(ratioStr: string): { s: number; f: number; w: number } {
      const parts = ratioStr.split(':').map(Number);
      return { s: parts[0] || 1, f: parts[1] || 1, w: parts[2] || 1 };
    }

    const tabFeeding = document.getElementById('tabFeeding');
    const tabTarget = document.getElementById('tabTarget');
    const modeFeeding = document.getElementById('modeFeeding');
    const modeTarget = document.getElementById('modeTarget');

    function switchMode(mode: 'feeding' | 'target') {
      if (mode === 'feeding') {
        modeFeeding!.style.display = '';
        modeTarget!.style.display = 'none';
        tabFeeding?.classList.add('active');
        tabFeeding?.classList.remove('btn-ghost');
        tabFeeding?.classList.add('btn-secondary');
        tabTarget?.classList.remove('active');
        tabTarget?.classList.add('btn-ghost');
        tabTarget?.classList.remove('btn-secondary');
      } else {
        modeFeeding!.style.display = 'none';
        modeTarget!.style.display = '';
        tabTarget?.classList.add('active');
        tabTarget?.classList.remove('btn-ghost');
        tabTarget?.classList.add('btn-secondary');
        tabFeeding?.classList.remove('active');
        tabFeeding?.classList.add('btn-ghost');
        tabFeeding?.classList.remove('btn-secondary');
      }
    }

    tabFeeding?.addEventListener('click', () => switchMode('feeding'));
    tabTarget?.addEventListener('click', () => switchMode('target'));

    const feedStarterInput = document.getElementById('feedStarter') as HTMLInputElement;
    const feedResultsEl = document.getElementById('feedResults');
    const copyFeedBtn = document.getElementById('copyFeed');
    const feedRatioBtns = document.querySelectorAll('.ratio-btn');
    const texts = JSON.parse(copyFeedBtn?.getAttribute('data-texts') || '{}');

    let currentFeedRatio = '1:1:1';

    function updateFeeding() {
      const starter = sanitizeNum(feedStarterInput?.value || '0');
      const r = parseRatio(currentFeedRatio);

      if (starter <= 0) {
        if (feedResultsEl) feedResultsEl.innerHTML = `<p style="color:var(--color-muted);">${escapeHtml(texts.enterStarter || '')}</p>`;
        return;
      }

      const flour = starter * (r.f / r.s);
      const water = starter * (r.w / r.s);
      const total = starter + flour + water;
      const existingFlour = starter / 2;
      const existingWater = starter / 2;
      const totalFlour = existingFlour + flour;
      const totalWater = existingWater + water;
      const hydration = totalFlour > 0 ? (totalWater / totalFlour) * 100 : 0;

      if (feedResultsEl) feedResultsEl.innerHTML = `
        <div class="result-row"><span class="label">${escapeHtml(texts.flourToAdd || '')}</span><span class="value">${flour.toFixed(1)}g</span></div>
        <div class="result-row"><span class="label">${escapeHtml(texts.waterToAdd || '')}</span><span class="value">${water.toFixed(1)}g</span></div>
        <div class="result-row"><span class="label">${escapeHtml(texts.totalAfterFeeding || '')}</span><span class="value" style="color:var(--color-caramel-dark);font-weight:700;">${total.toFixed(1)}g</span></div>
        <div class="result-row"><span class="label">${escapeHtml(texts.starterHydration || '')}</span><span class="value">${hydration.toFixed(1)}%</span></div>
      `;
    }

    feedStarterInput?.addEventListener('input', updateFeeding);

    feedRatioBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        feedRatioBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFeedRatio = (btn as HTMLElement).dataset.ratio || '1:1:1';
        updateFeeding();
      });
    });

    copyFeedBtn?.addEventListener('click', () => {
      const rows = feedResultsEl?.querySelectorAll('.result-row') || [];
      const text = buildCopyText(Array.from(rows).map(row => ([
        row.querySelector('.label')?.textContent?.trim() || '',
        row.querySelector('.value')?.textContent?.trim() || '',
      ])));
      if (!navigator.clipboard) { console.warn('Clipboard not available'); return; }
      navigator.clipboard.writeText(text).then(() => {
        copyFeedBtn.classList.add('copied');
        copyFeedBtn.innerHTML = getCopyButtonMarkup(texts.copied || '', 'success');
        setTimeout(() => {
          copyFeedBtn.classList.remove('copied');
          copyFeedBtn.innerHTML = getCopyButtonMarkup(texts.copyResult || '');
        }, 2000);
      }).catch((e) => { console.warn('Copy failed:', e); });
    });

    const targetAmountInput = document.getElementById('targetAmount') as HTMLInputElement;
    const existingStarterInput = document.getElementById('existingStarter') as HTMLInputElement;
    const targetResultsEl = document.getElementById('targetResults');
    const copyTargetBtn = document.getElementById('copyTarget');
    const targetRatioBtns = document.querySelectorAll('.ratio-btn-target');

    let currentTargetRatio = '1:1:1';

    function updateTarget() {
      const desiredTotal = sanitizeNum(targetAmountInput?.value || '0');
      const existingStarter = sanitizeNum(existingStarterInput?.value || '0');

      if (desiredTotal <= 0) {
        if (targetResultsEl) targetResultsEl.innerHTML = `<p style="color:var(--color-muted);">${escapeHtml(texts.enterDesired || '')}</p>`;
        return;
      }

      const plan = calculateSourdoughTargetPlan({
        desiredTotal,
        existingStarter,
        ratio: currentTargetRatio,
      });

      if (!plan) {
        if (targetResultsEl) targetResultsEl.innerHTML = `<p style="color:var(--color-muted);">${escapeHtml(texts.enterDesired || '')}</p>`;
        return;
      }

      let html = `
        <div class="result-row"><span class="label">${escapeHtml(texts.flourNeeded || '')}</span><span class="value">${plan.flourNeeded.toFixed(1)}g</span></div>
        <div class="result-row"><span class="label">${escapeHtml(texts.waterNeeded || '')}</span><span class="value">${plan.waterNeeded.toFixed(1)}g</span></div>
        <div class="result-row"><span class="label">${escapeHtml(texts.useExistingStarter || '')}</span><span class="value">${plan.starterToUse.toFixed(1)}g</span></div>
      `;

      if (plan.discardAmount > 0.001) {
        html += `<div class="result-row"><span class="label">${escapeHtml(texts.discardAmount || '')}</span><span class="value" style="color:var(--color-rust);">${plan.discardAmount.toFixed(1)}g</span></div>`;
      } else {
        html += `<div class="result-row"><span class="label">${escapeHtml(texts.discardAmount || '')}</span><span class="value" style="color:var(--color-success);">${escapeHtml(texts.noneNeeded || '')}</span></div>`;
      }

      html += `<div class="result-row"><span class="label">${escapeHtml(plan.feasible ? texts.newStarterTotal || '' : texts.achievableTotal || '')}</span><span class="value" style="color:var(--color-caramel-dark);font-weight:700;">${plan.finalTotal.toFixed(1)}g</span></div>`;

      if (!plan.feasible) {
        html = `
          <div style="margin-bottom:var(--space-md);padding:12px 14px;border:1px solid var(--color-rust);border-radius:12px;background:color-mix(in srgb, var(--color-rust) 10%, transparent);text-align:left;">
            <strong style="display:block;color:var(--color-rust);margin-bottom:4px;">${escapeHtml(texts.targetNotReachable || '')}</strong>
            <p style="margin:0;color:var(--color-text);font-size:0.92rem;">${escapeHtml(texts.insufficientStarterNote || '')}</p>
          </div>
          ${html}
          <div class="result-row"><span class="label">${escapeHtml(texts.requiredStarter || '')}</span><span class="value">${plan.requiredStarter.toFixed(1)}g</span></div>
          <div class="result-row"><span class="label">${escapeHtml(texts.targetShortfall || '')}</span><span class="value" style="color:var(--color-rust);">${plan.deficit.toFixed(1)}g</span></div>
        `;
      }

      if (targetResultsEl) targetResultsEl.innerHTML = html;
    }

    targetAmountInput?.addEventListener('input', updateTarget);
    existingStarterInput?.addEventListener('input', updateTarget);

    targetRatioBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        targetRatioBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentTargetRatio = (btn as HTMLElement).dataset.ratio || '1:1:1';
        updateTarget();
      });
    });

    copyTargetBtn?.addEventListener('click', () => {
      const rows = targetResultsEl?.querySelectorAll('.result-row') || [];
      const footer = targetResultsEl?.querySelector('strong')?.textContent?.trim() || '';
      const note = targetResultsEl?.querySelector('p')?.textContent?.trim() || '';
      const text = buildCopyText(Array.from(rows).map(row => ([
        row.querySelector('.label')?.textContent?.trim() || '',
        row.querySelector('.value')?.textContent?.trim() || '',
      ])), [footer, note].filter(Boolean).join('\n'));
      if (!navigator.clipboard) { console.warn('Clipboard not available'); return; }
      navigator.clipboard.writeText(text).then(() => {
        copyTargetBtn.classList.add('copied');
        copyTargetBtn.innerHTML = getCopyButtonMarkup(texts.copied || '', 'success');
        setTimeout(() => {
          copyTargetBtn.classList.remove('copied');
          copyTargetBtn.innerHTML = getCopyButtonMarkup(texts.copyResult || '');
        }, 2000);
      }).catch((e) => { console.warn('Copy failed:', e); });
    });

    targetAmountInput?.addEventListener('input', () => {
      if (!existingStarterInput?.value || parseFloat(existingStarterInput.value) === 0) {
        existingStarterInput.value = targetAmountInput.value;
        updateTarget();
      }
    });

    updateFeeding();
    updateTarget();
  }

  init();
</script>
